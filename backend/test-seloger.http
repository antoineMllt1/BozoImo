### Test de l'API SeLoger

### Variables
@baseUrl = http://localhost:5000
@apiUrl = {{baseUrl}}/api/seloger

###############################################
# 1. Test de recherche par adresse/quartier
###############################################

### Recherche pour "Savarières"
POST {{apiUrl}}/search
Content-Type: application/json

{
  "address": "Savarieres"
}

### Recherche pour un autre quartier
POST {{apiUrl}}/search
Content-Type: application/json

{
  "address": "Belleville Paris"
}

### Recherche pour une ville
POST {{apiUrl}}/search
Content-Type: application/json

{
  "address": "Nantes"
}

###############################################
# 2. Test de l'autocomplete
###############################################

### Autocomplete pour "Savarieres"
POST {{apiUrl}}/autocomplete
Content-Type: application/json

{
  "text": "Savarieres"
}

### Autocomplete pour "Paris"
POST {{apiUrl}}/autocomplete
Content-Type: application/json

{
  "text": "Paris"
}

###############################################
# 3. Tests d'erreur
###############################################

### Test sans paramètre address
POST {{apiUrl}}/search
Content-Type: application/json

{
}

### Test avec paramètre invalide
POST {{apiUrl}}/search
Content-Type: application/json

{
  "address": 123
}

