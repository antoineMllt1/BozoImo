# ── Variables à configurer sur Railway ──────────────────────────────────
# Sert le frontend React depuis Express (obligatoire sur Railway)
ELECTRON_STATIC=true

# Port (Railway le définit automatiquement, ne pas changer)
# PORT=3000

# Optionnel : forcer le chemin de Chromium si auto-détection échoue
# CHROME_EXECUTABLE=/usr/bin/chromium
