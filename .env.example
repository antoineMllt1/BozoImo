# ── Variables à configurer sur Railway ──────────────────────────────────
# Sert le frontend React depuis Express (obligatoire sur Railway)
ELECTRON_STATIC=true

# Port (Railway le définit automatiquement, ne pas changer)
# PORT=3000

# Optionnel : forcer le chemin de Chromium si auto-détection échoue
# CHROME_EXECUTABLE=/usr/bin/chromium

# ── Comptes agents & historique (bêta) ──────────────────────────────────
# Fournie automatiquement par Railway quand un plugin Postgres est attaché.
# En local, colle ici l'URL publique de cette même base (Railway → plugin
# Postgres → onglet "Connect" → "Public Network") pour développer contre
# les vraies données.
# DATABASE_URL=postgresql://user:password@host:port/dbname

# Secret de signature des sessions (JWT). Génère une valeur aléatoire et ne
# la change jamais après le lancement (ça déconnecterait tout le monde) :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# JWT_SECRET=

# Optionnel : code requis à l'inscription pour limiter la bêta aux agents
# invités. Laisse vide/absent pour une inscription libre.
# BETA_INVITE_CODE=
